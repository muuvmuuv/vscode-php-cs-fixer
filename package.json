{
	"name": "vscode-just-php-cs-fixer",
	"displayName": "PHP Formatter PHP-CS-Fixer",
	"version": "1.2.0",
	"description": "Run just PHP-CS-Fixer.",
	"icon": "assets/logo.png",
	"publisher": "muuvmuuv",
	"qna": "https://github.com/muuvmuuv/vscode-php-cs-fixer/issues/new/choose",
	"categories": [
		"Formatters"
	],
	"keywords": [
		"php",
		"php-cs-fixer",
		"php-formatter",
		"formatter",
		"format",
		"multi-root ready"
	],
	"homepage": "https://github.com/muuvmuuv/vscode-php-cs-fixer",
	"bugs": {
		"url": "https://github.com/muuvmuuv/vscode-php-cs-fixer/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/muuvmuuv/vscode-php-cs-fixer.git"
	},
	"license": "GPLv3",
	"author": {
		"name": "Marvin Heilemann",
		"email": "bloggt.raschelt.0m@icloud.com",
		"url": "https://marvin.digital/"
	},
	"main": "./dist/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run package",
		"dev": "node esbuild.mjs --watch",
		"compile": "node esbuild.mjs",
		"compile-source": "tsc",
		"package": "node esbuild.mjs --production",
		"check": "biome check .",
		"format": "biome check --write .",
		"pretest": "npm run compile-source && npm run compile",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@commitlint/cli": "^20.3.1",
		"@commitlint/config-conventional": "^20.3.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.15.18",
		"@types/vscode": "^1.108.1",
		"@vscode/test-cli": "^0.0.12",
		"@vscode/test-electron": "^2.5.2",
		"esbuild": "^0.27.2",
		"lefthook": "^2.0.16",
		"typescript": "^5.9.3"
	},
	"engines": {
		"vscode": "^1.108.0"
	},
	"activationEvents": [
		"onLanguage:php"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "This extension executes PHP-CS-Fixer from the workspace which could pose security risks in untrusted workspaces.",
			"restrictedConfigurations": [
				"php-cs-fixer.executable",
				"php-cs-fixer.config"
			]
		}
	},
	"contributes": {
		"configuration": {
			"type": "object",
			"title": "PHP-CS-Fixer Configurations",
			"properties": {
				"php-cs-fixer.executable": {
					"type": "string",
					"description": "The executable name or relative path."
				},
				"php-cs-fixer.config": {
					"type": "string",
					"description": "The config path."
				},
				"php-cs-fixer.allow-risky": {
					"type": "boolean",
					"default": false,
					"description": "Allow risky rules."
				}
			}
		}
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	}
}
